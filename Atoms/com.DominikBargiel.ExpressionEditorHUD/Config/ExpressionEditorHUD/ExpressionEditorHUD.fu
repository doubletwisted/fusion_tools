{
    Action {
        ID = "ExpressionEditor_Show",
        Name = "Expression Editor",
        Visible = true,

        Args = {},

        Targets = {
            Composition = {
                Execute = [[
print("[ExpressionEditor] Action triggered")

-- Call our script with mouse position as direct arguments
target:RunScript("$CFG/ExpressionEditorHUD.lua", {mousex = args._sxpos, mousey = args._sypos})
]],
            },
        },
    },

    Hotkeys {
        Target = "FlowView",
        E = "ExpressionEditor_Show",
    },
} 

